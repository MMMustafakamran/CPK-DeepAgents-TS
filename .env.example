# CopilotKit + Deep Agents (TypeScript) test suite — environment
#
# There are TWO processes here, so there are two places these go:
#
#   backend/.env         read by the LangGraph dev server (langgraph.json points at it)
#   frontend/.env.local  read by Next.js at startup
#
# Copy the relevant block into each. Never commit the filled-in files.


# ── backend/.env — required ──────────────────────────────────────────────────

# OpenAI API key. Every agent runs on an OpenAI model via @langchain/openai.
OPENAI_API_KEY=sk-...


# ── backend/.env — optional ──────────────────────────────────────────────────

# Model for every agent. The doc pages this repo implements name three
# different ids across them — `openai:gpt-4o` on Quickstart and Tool Rendering,
# `gpt-5.4` on Predictive State Updates, `gpt-4o-mini` inside the
# manual-emission snippet — so all agents read this instead of hardcoding one
# each. Defaults to gpt-4o.
# OPENAI_MODEL=gpt-4o


# ── frontend/.env.local — optional ───────────────────────────────────────────

# Where the Next runtime route forwards agent runs.
#
# Defaults to http://localhost:8124 — NOT the Quickstart's 8123. The Python
# sibling repo uses 8123 and publishes identical graph ids, so if both ran on
# one port whichever server bound first would silently answer for the other
# language. Change it here and in the `--port` flag together.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8124

# LangSmith / LangGraph Platform key, sent as `langsmithApiKey` on every
# LangGraphAgent. A locally running dev server does not check it, so it is
# empty in local development — the Quickstart's snippet defaults it to "" for
# the same reason. Only needed against a LangGraph Platform deployment.
# LANGSMITH_API_KEY=lsv2_...

# Silences the runtime's anonymous telemetry notice on startup.
# COPILOTKIT_TELEMETRY_DISABLED=true
